# ==============================================================================
# EduPulse AWS JSON-Only Deployment Environment Variables
# ==============================================================================
# Copy this file to .env on the EC2 host:
#   cp .env.aws-json.example .env
# Protect permissions:
#   chmod 600 .env
# ==============================================================================

# Required: 256-bit Hex JWT Secret for signing authentication tokens
# Generate with: openssl rand -hex 32
JWT_SECRET=replace_with_a_secure_random_64_char_hex_secret

# Host Persistent Storage Path (EBS mount point on Ubuntu host)
EDUPULSE_DATA_HOST_PATH=/mnt/edupulse-data

# Backend Service Port
BACKEND_PORT=8081

# Host Bind IP (use 127.0.0.1 if using reverse proxy like Nginx, or 0.0.0.0 for direct access)
HOST_BIND_IP=127.0.0.1

# Fixture seeding (MUST be false for clean production EBS volume)
ERP_DEVJSON_SEED_FIXTURES=false

# Initial Super Admin Bootstrapping (Enable only for the very first startup on a fresh volume)
BOOTSTRAP_SUPERADMIN_ENABLED=false
BOOTSTRAP_SUPERADMIN_USERNAME=superadmin
BOOTSTRAP_SUPERADMIN_EMAIL=superadmin@yourinstitution.edu
BOOTSTRAP_SUPERADMIN_PASSWORD=replace_with_a_strong_production_password
