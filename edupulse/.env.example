# ==============================================================================
# EduPulse Infrastructure Services Environment Configuration (Production)
# ==============================================================================
# Copy this template to .env or inject these variables in your deployment pipeline.
# NEVER commit real credentials to version control.

# PostgreSQL Configuration
POSTGRES_DB=edupulse_erp
POSTGRES_USER=edupulse_admin
POSTGRES_PASSWORD=your_strong_postgres_password_here

# Redis Configuration
REDIS_PASSWORD=your_strong_redis_password_here

# RabbitMQ Configuration
RABBITMQ_DEFAULT_USER=edupulse_mq
RABBITMQ_DEFAULT_PASS=your_strong_rabbitmq_password_here

# MinIO Object Storage Configuration
MINIO_ROOT_USER=edupulse_minio_admin
MINIO_ROOT_PASSWORD=your_strong_minio_password_here
